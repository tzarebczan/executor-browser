{
  "manifest_version": 3,
  "name": "Executor Browser",
  "version": "0.1.0",
  "description": "Connect your Chrome to Executor: side panel, agent tab groups, live preview, one-click companion pairing.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Executor Browser",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "sidePanel",
    "tabGroups",
    "tabs",
    "activeTab",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*/*",
    "http://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://tbd.jiggytom.com/*",
      "http://localhost:3000/*",
      "https://*.ts.net/*"
    ]
  }
}
